# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── RAG Tuning ───────────────────────────────────────────────────────────────
EMBEDDING_DIMENSIONS=3072
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MATCH_THRESHOLD=0.45
MATCH_COUNT=5

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Add every URL your frontend is served from (including www. variant if applicable).
ALLOWED_ORIGINS=https://yourportfolio.com,https://www.yourportfolio.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key required in the X-API-Key header to call POST /api/ingest.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=your-strong-random-key-here

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Maximum allowed .txt upload size in bytes (default: 5 MB = 5242880)
MAX_UPLOAD_BYTES=5242880

# ─── Runtime environment ──────────────────────────────────────────────────────
# Set to "development" to enable /docs, /redoc, and /openapi.json endpoints.
# Must be "production" (or absent) in deployed environments.
ENVIRONMENT=production
