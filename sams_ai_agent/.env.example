# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ─── RAG Tuning ───────────────────────────────────────────────────────────────
# gemini-embedding-2 outputs 3072 dims by default (Matryoshka: 1536 / 768 also supported).
# Must match the VECTOR() dimension in the DB — do not change unless you re-create the table.
EMBEDDING_DIMENSIONS=3072
# Larger chunks suit gemini-embedding-2's bigger context window.
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
MATCH_THRESHOLD=0.45
MATCH_COUNT=5

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Add every URL your frontend is served from (including www. variant if applicable).
ALLOWED_ORIGINS=https://yourportfolio.com,https://www.yourportfolio.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key required in the X-API-Key header to call POST /api/ingest.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=your-strong-random-key-here

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Maximum allowed upload size in bytes (default: 20 MB).
# Accommodates PDFs, images, .docx files, and plain text.
MAX_UPLOAD_BYTES=20971520

# ─── Runtime environment ──────────────────────────────────────────────────────
# Set to "development" to enable /docs, /redoc, and /openapi.json endpoints.
# Must be "production" (or absent) in deployed environments.
ENVIRONMENT=production
