# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Admin Access Control ──────────────────────────────────────────────────────
# Only this email can access /admin and write to the database
ADMIN_EMAIL=you@example.com

# ─── Sams AI Agent ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ exposes the URL to the browser — NOT used for queries any more.
# Queries go through /api/sams/query (server-side proxy).
# Keep NEXT_PUBLIC_SAMS_API_URL only if other client-side code needs it.
NEXT_PUBLIC_SAMS_API_URL=https://your-sams-agent.vercel.app
# Server-side only — never sent to the browser
SAMS_API_URL=https://your-sams-agent.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Random secret used to hash IP addresses before storing them in Supabase.
# Generate one with: openssl rand -hex 32
RATE_LIMIT_SALT=replace-with-a-random-secret
